{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
          "/clip-download/": {
            "Proxy": "http://api:8000"
          },
        "/": {
          "Proxy": "http://127.0.0.1:8001"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false
  }
}
